generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WatchSource {
  id                  String    @id @default(cuid())
  name                String
  storeName           String
  url                 String    @unique
  type                String    @default("html")
  enabled             Boolean   @default(true)
  lastCheckedAt       DateTime?
  lastSuccess         Boolean?
  lastHttpStatus      Int?
  lastFetchedCount    Int       @default(0)
  lastNewListingCount Int       @default(0)
  lastMatchedKeywords String?
  lastError           String?
  memo                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([enabled])
  @@index([type])
  @@index([storeName])
}

model DiscoveryQuery {
  id                String             @id @default(cuid())
  name              String
  query             String
  type              String             @default("both")
  category          String             @default("other")
  enabled           Boolean            @default(true)
  memo              String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  discoveredSources DiscoveredSource[]

  @@index([enabled])
  @@index([type])
  @@index([category])
}

model DiscoveredSource {
  id               String          @id @default(cuid())
  discoveryQueryId String
  title            String
  url              String
  normalizedUrl    String          @unique
  description      String?
  detectedType     String          @default("unknown")
  discoveryType    String          @default("unknown")
  category         String          @default("other")
  confidenceScore  Float           @default(0)
  matchedKeywords  String?
  reason           String?
  providerName     String?
  searchUrlTemplateCandidate String?
  requiresReview   Boolean         @default(false)
  rawText          String?
  aiClassifiedAt   DateTime?
  aiModel          String?
  aiIsLotteryApplicationPage Boolean?
  aiIsCurrentlyOpen Boolean?
  aiIsPastOrEnded  Boolean?
  aiIsJustArticle  Boolean?
  aiIsProductSalesPage Boolean?
  aiIsPriceBuybackPage Boolean?
  aiCategory       String?
  aiConfidenceScore Float?
  aiApplicationStartAt DateTime?
  aiApplicationEndAt DateTime?
  aiResultAnnouncementAt DateTime?
  aiPurchaseDeadlineAt DateTime?
  articlePublishedAt DateTime?
  aiReason         String?
  aiExcludeReason  String?
  sourceUsefulness String          @default("manual_review")
  aiRecommendedAction String       @default("manual_review")
  aiCanAutoRegister Boolean        @default(false)
  aiCanAutoEnable Boolean          @default(false)
  aiTrustLevel     String          @default("low")
  aiSourceReason   String?
  aiRiskReason     String?
  status           String          @default("new")
  discoveredAt     DateTime        @default(now())
  lastSeenAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  discoveryQuery   DiscoveryQuery  @relation(fields: [discoveryQueryId], references: [id], onDelete: Cascade)

  @@index([discoveryQueryId])
  @@index([detectedType])
  @@index([discoveryType])
  @@index([articlePublishedAt])
  @@index([category])
  @@index([confidenceScore])
  @@index([aiIsLotteryApplicationPage])
  @@index([aiIsCurrentlyOpen])
  @@index([aiConfidenceScore])
  @@index([sourceUsefulness])
  @@index([aiRecommendedAction])
  @@index([aiTrustLevel])
  @@index([aiCanAutoRegister])
  @@index([aiCanAutoEnable])
  @@index([status])
  @@index([discoveredAt])
  @@index([lastSeenAt])
}

model LotteryListing {
  id                       String         @id @default(cuid())
  title                    String
  productName              String
  storeName                String
  sourceName               String
  sourceUrl                String
  lotteryUrl               String         @unique
  imageUrl                 String?
  description              String?
  applicationStartAt       DateTime?
  applicationEndAt         DateTime?
  resultAnnouncementAt     DateTime?
  purchaseDeadlineAt       DateTime?
  detectedAt               DateTime       @default(now())
  lastSeenAt               DateTime       @default(now())
  status                   String         @default("unknown")
  discoveryType            String         @default("unknown")
  confidenceScore          Float          @default(0)
  matchedKeywords          String?
  confidenceReason         String?
  extractedDatesRaw        String?
  normalizedUrl            String?
  contentHash              String?
  retailPrice              Int?
  bestBuyPrice             Int?
  estimatedProfit          Int?
  profitRate               Float?
  roi                      Float?
  priceMultiplier          Float?
  priceCheckedAt           DateTime?
  priceStatus              String         @default("unchecked")
  aiClassifiedAt           DateTime?
  aiModel                  String?
  aiIsLotteryApplicationPage Boolean?
  aiIsCurrentlyOpen        Boolean?
  aiIsPastOrEnded          Boolean?
  aiIsJustArticle          Boolean?
  aiIsProductSalesPage     Boolean?
  aiIsPriceBuybackPage     Boolean?
  aiCategory               String?
  aiConfidenceScore        Float?
  aiApplicationStartAt     DateTime?
  aiApplicationEndAt       DateTime?
  aiResultAnnouncementAt   DateTime?
  aiPurchaseDeadlineAt     DateTime?
  articlePublishedAt       DateTime?
  aiReason                 String?
  aiExcludeReason          String?
  applicationPriorityScore Float          @default(0)
  applicationPriorityLabel String         @default("D")
  ignored                  Boolean        @default(false)
  ignoredReason            String?
  ignoredAt                DateTime?
  userVerdict              String?
  userVerdictMemo          String?
  userVerdictAt            DateTime?
  applicationStatus        String         @default("not_applied")
  appliedAt                DateTime?
  wonAt                    DateTime?
  lostAt                   DateTime?
  purchasedAt              DateTime?
  soldAt                   DateTime?
  skippedAt                DateTime?
  purchasePrice            Int?
  purchaseMemo             String?
  salePrice                Int?
  shippingCost             Int?
  fee                      Int?
  actualProfit             Int?
  actualProfitRate         Float?
  actualRoi                Float?
  saleDestination          String?
  saleMemo                 String?
  rawText                  String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  priceRecords             PriceRecord[]
  notifications            Notification[]

  @@index([productName])
  @@index([storeName])
  @@index([status])
  @@index([discoveryType])
  @@index([applicationEndAt])
  @@index([articlePublishedAt])
  @@index([detectedAt])
  @@index([lastSeenAt])
  @@index([contentHash])
  @@index([priceStatus])
  @@index([aiIsLotteryApplicationPage])
  @@index([aiIsCurrentlyOpen])
  @@index([aiConfidenceScore])
  @@index([estimatedProfit])
  @@index([roi])
  @@index([applicationPriorityScore])
  @@index([applicationPriorityLabel])
  @@index([ignored])
  @@index([userVerdict])
  @@index([applicationStatus])
  @@index([soldAt])
  @@index([actualProfit])
  @@index([actualRoi])
}

model Notification {
  id               String         @id @default(cuid())
  lotteryListingId String
  type             String
  title            String
  message          String
  severity         String         @default("info")
  read             Boolean        @default(false)
  createdAt        DateTime       @default(now())
  readAt           DateTime?
  updatedAt        DateTime       @updatedAt
  lotteryListing   LotteryListing @relation(fields: [lotteryListingId], references: [id], onDelete: Cascade)

  @@index([lotteryListingId])
  @@index([type])
  @@index([severity])
  @@index([read])
  @@index([createdAt])
}

model CollectorRun {
  id                  String             @id @default(cuid())
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  targetSourceCount   Int                @default(0)
  successCount        Int                @default(0)
  errorCount          Int                @default(0)
  newListingCount     Int                @default(0)
  updatedListingCount Int                @default(0)
  skippedCount        Int                @default(0)
  errorMessage        String?
  createdAt           DateTime           @default(now())
  items               CollectorRunItem[]

  @@index([startedAt])
}

model CollectorRunItem {
  id                  String       @id @default(cuid())
  collectorRunId      String
  watchSourceId       String?
  sourceName          String
  storeName           String
  sourceUrl           String
  type                String
  startedAt           DateTime     @default(now())
  finishedAt          DateTime?
  success             Boolean      @default(false)
  httpStatus          Int?
  fetchedCount        Int          @default(0)
  matchedKeywords     String?
  newListingCount     Int          @default(0)
  updatedListingCount Int          @default(0)
  skippedCount        Int          @default(0)
  errorMessage        String?
  createdAt           DateTime     @default(now())
  run                 CollectorRun @relation(fields: [collectorRunId], references: [id], onDelete: Cascade)

  @@index([collectorRunId])
  @@index([watchSourceId])
  @@index([success])
}

model SourcePreset {
  id             String   @id @default(cuid())
  name           String
  storeName      String
  url            String   @unique
  type           String   @default("html")
  category       String
  description    String?
  defaultEnabled Boolean  @default(false)
  recommended    Boolean  @default(false)
  tags           String?
  memo           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([recommended])
  @@index([storeName])
}

model PriceSourcePreset {
  id                String   @id @default(cuid())
  name              String
  shopName          String
  baseUrl           String
  searchUrlTemplate String   @unique
  category          String
  description       String?
  defaultEnabled    Boolean  @default(false)
  recommended       Boolean  @default(false)
  tags              String?
  memo              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
  @@index([recommended])
  @@index([shopName])
  @@index([baseUrl])
}

model PriceSource {
  id                String    @id @default(cuid())
  name              String
  shopName          String
  baseUrl           String
  searchUrlTemplate String
  enabled           Boolean   @default(true)
  memo              String?
  lastCheckedAt     DateTime?
  lastSuccessAt     DateTime?
  lastHttpStatus    Int?
  successCount      Int       @default(0)
  failureCount      Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enabled])
  @@index([shopName])
}

model PriceRecord {
  id               String         @id @default(cuid())
  lotteryListingId String
  productName      String
  shopName         String
  price            Int
  sourceUrl        String
  matchedTitle     String
  confidenceScore  Float          @default(0)
  extractedAt      DateTime       @default(now())
  rawText          String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  lotteryListing   LotteryListing @relation(fields: [lotteryListingId], references: [id], onDelete: Cascade)

  @@unique([lotteryListingId, sourceUrl, matchedTitle])
  @@index([lotteryListingId])
  @@index([shopName])
  @@index([price])
  @@index([extractedAt])
}

model PriceCollectorRun {
  id                String    @id @default(cuid())
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  targetCount       Int       @default(0)
  successCount      Int       @default(0)
  errorCount        Int       @default(0)
  newPriceCount     Int       @default(0)
  updatedPriceCount Int       @default(0)
  errorMessage      String?
  createdAt         DateTime  @default(now())

  @@index([startedAt])
}

model ExclusionKeyword {
  id        String   @id @default(cuid())
  keyword   String   @unique
  enabled   Boolean  @default(true)
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model BackupRecord {
  id        String   @id @default(cuid())
  filename  String
  path      String
  sizeBytes Int
  createdAt DateTime @default(now())
  memo      String?

  @@index([createdAt])
  @@index([filename])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model OperationRun {
  id         String    @id @default(cuid())
  type       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  success    Boolean   @default(false)
  message    String?
  createdAt  DateTime  @default(now())

  @@index([type])
  @@index([startedAt])
  @@index([success])
}
